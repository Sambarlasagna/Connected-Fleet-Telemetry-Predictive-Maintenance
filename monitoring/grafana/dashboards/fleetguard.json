{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "FleetGuard — Real-time fleet health, simulation, ML, and API observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Fleet Health",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "title": "Critical Machines",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_critical_machines", "legendFormat": "Critical", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "title": "Active Alerts",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_active_alerts", "legendFormat": "Alerts", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "red", "value": 0.7 }
            ]
          },
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto" },
      "title": "Avg Failure Probability",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_avg_failure_probability", "legendFormat": "Avg Prob", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "title": "Simulation Running",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_simulation_running", "legendFormat": "Running", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "title": "Sim Speed",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_simulation_speed", "legendFormat": "Speed", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "healthy" }, "properties": [{ "id": "color", "value": { "fixedColor": "#34d399", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "at_risk" }, "properties": [{ "id": "color", "value": { "fixedColor": "#fbbf24", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f87171", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "Machines by Risk Level",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "fleetguard_machines_by_risk{risk_level=\"healthy\"}", "legendFormat": "healthy", "refId": "A" },
        { "datasource": "Prometheus", "expr": "fleetguard_machines_by_risk{risk_level=\"at_risk\"}", "legendFormat": "at_risk", "refId": "B" },
        { "datasource": "Prometheus", "expr": "fleetguard_machines_by_risk{risk_level=\"critical\"}", "legendFormat": "critical", "refId": "C" }
      ]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Avg Fleet Failure Probability Over Time",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "fleetguard_avg_failure_probability", "legendFormat": "Avg Failure Prob", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 200,
      "title": "API Performance",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 20,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "API Request Rate (req/s)",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(http_requests_total[1m])", "legendFormat": "{{handler}} {{method}}", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 21,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "API P95 Latency (ms)",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[2m])) * 1000", "legendFormat": "p95 {{handler}}", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 300,
      "title": "Simulation & Kafka",
      "type": "row"
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "id": 30,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Simulation Ticks/s",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(fleetguard_simulation_ticks_total[1m])", "legendFormat": "ticks/s", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Kafka Messages Produced/s",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(fleetguard_kafka_messages_total[1m])", "legendFormat": "produced/s", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 32,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Kafka Messages Consumed/s",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(fleetguard_kafka_messages_consumed_total[1m])", "legendFormat": "consumed/s", "refId": "A" }]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["fleetguard", "fleet", "ml", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FleetGuard Operations",
  "uid": "fleetguard-ops",
  "version": 1
}
