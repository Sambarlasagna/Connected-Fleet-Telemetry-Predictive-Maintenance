# FleetGuard Production Environment Variables
# Copy to .env and fill in values before running docker-compose.prod.yml

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── Server ──────────────────────────────────────────────────────────────────
# Set to EC2 public IP or domain name
SERVER_HOST=your-ec2-ip-or-domain.com

# ── AWS (optional — for S3 telemetry archiving) ──────────────────────────────
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=fleetguard-telemetry-xxxxxxxx

# ── Kafka (optional — leave blank to use direct DB mode) ─────────────────────
KAFKA_BOOTSTRAP_SERVERS=

# ── MLflow ───────────────────────────────────────────────────────────────────
# Uses SQLite inside container by default (no external server needed)
# MLFLOW_TRACKING_URI=sqlite:////app/mlruns/mlflow.db
